# notetoself - systemd unit
#
# Install:
#   sudo cp deploy/notetoself.service /etc/systemd/system/notetoself.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now notetoself.service
#
# Adjust User/Group, WorkingDirectory, EnvironmentFile, and ExecStart paths if
# your install root is not /opt/notetoself. The unit assumes a dedicated
# unprivileged user "notetoself" owns both the install root and the
# env file. Create it once with:
#   sudo useradd --system --home /opt/notetoself --shell /usr/sbin/nologin notetoself

[Unit]
Description=notetoself MCP server
Documentation=https://github.com/ScottYates/mcp-notetoself
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=notetoself
Group=notetoself
WorkingDirectory=/opt/notetoself
EnvironmentFile=/etc/notetoself/notetoself.env
ExecStart=/opt/notetoself/.venv/bin/python /opt/notetoself/server.py

# Restart on crashes; leave manual stops alone.
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

# Hardening: the server needs network, time, DNS, its own install dir, and
# the env file. Nothing else.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=

# Logs go to the journal; pick them up with:
#   journalctl -u notetoself.service -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=notetoself

[Install]
WantedBy=multi-user.target
