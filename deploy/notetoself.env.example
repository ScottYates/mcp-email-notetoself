# ----------------------------------------------------------------------------
# notetoself - environment configuration
#
# This template lives in deploy/ so the systemd unit can find it during
# install. After copying the repo to /opt/notetoself, copy this file to
# /opt/notetoself/.env (mode 0600, owned by the service user) and edit:
#
#   sudo install -o notetoself -g notetoself -m 0644 \
#        deploy/notetoself.env.example /opt/notetoself/.env
#   sudo chmod 0600 /opt/notetoself/.env
#   sudo -u notetoself $EDITOR /opt/notetoself/.env
#
# The systemd unit reads /opt/notetoself/.env via its EnvironmentFile
# directive. Format is `KEY=VALUE` per line, no `export`. systemd also
# supports `KEY=` to unset.
# ----------------------------------------------------------------------------

# --- Email transport (Gmail SMTP) -------------------------------------------
# Gmail address that will send the note (FROM). Almost always the same as the
# destination for a "note to self" tool.
SMTP_USER=beernutz@gmail.com

# Gmail "App Password" - NOT your normal Gmail password.
# Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account).
SMTP_PASS=

# Destination address (the "self" in note-to-self).
TO_EMAIL=beernutz@gmail.com

# SMTP server settings. Gmail defaults shown; only change if you know why.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- HTTP server -------------------------------------------------------------
# 0.0.0.0 listens on every interface. Change to 127.0.0.1 if you only want
# local clients to reach the server.
HOST=0.0.0.0
PORT=3001

# --- MCP transport security --------------------------------------------------
# Comma-separated list of allowed `Host` header values. Requests whose Host
# header is not in this list are rejected with HTTP 421 (DNS rebinding
# protection). When the server is reached via a reverse proxy on a public
# domain (e.g. https://yatesframe.com/mcp), that domain MUST be listed here,
# otherwise the MCP client will see "Invalid Host header" errors.
# Loopback hosts are listed by default so local testing keeps working.
ALLOWED_HOSTS=127.0.0.1,localhost,[::1],yatesframe.com

# --- Bearer-token authorization ----------------------------------------------
# JSON array of allowed bearer tokens. Requests must carry
# `Authorization: Bearer <token>` whose value matches one of these entries.
#
# Generate tokens with: python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Single token:
# TOKENS_JSON=["REPLACE_WITH_LONG_RANDOM_STRING"]
#
# Multiple clients (each gets its own token):
# TOKENS_JSON=["token-aaa", "token-bbb"]
TOKENS_JSON=[]
