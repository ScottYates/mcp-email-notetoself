# ----------------------------------------------------------------------------
# notetoself - environment configuration for the systemd unit
#
# Install at /etc/notetoself/notetoself.env with mode 0600,
# owned by the user the systemd unit runs as (default: notetoself).
#
#   sudo install -d -o notetoself -g notetoself -m 0750 /etc/notetoself
#   sudo cp deploy/notetoself.env.example /etc/notetoself/notetoself.env
#   sudo chmod 0600 /etc/notetoself/notetoself.env
#   sudo chown notetoself:notetoself /etc/notetoself/notetoself.env
#
# The unit reads this file via systemd's EnvironmentFile directive, so the
# format is `KEY=VALUE` per line, no `export`, no quoting around values that
# contain spaces. systemd also supports `KEY=` to unset.
# ----------------------------------------------------------------------------

# --- Email transport (Gmail SMTP) -------------------------------------------
# Gmail address that will send the note (FROM). Almost always the same as the
# destination for a "note to self" tool.
SMTP_USER=beernutz@gmail.com

# Gmail "App Password" - NOT your normal Gmail password.
# Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account).
SMTP_PASS=

# Destination address (the "self" in note-to-self).
TO_EMAIL=beernutz@gmail.com

# SMTP server settings. Gmail defaults shown; only change if you know why.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- HTTP server -------------------------------------------------------------
# 0.0.0.0 listens on every interface. Change to 127.0.0.1 if you only want
# local clients to reach the server.
HOST=0.0.0.0
PORT=3001

# --- Client authorization ----------------------------------------------------
# Map of allowed client_id -> token. Only requests whose `X-Client-ID`
# header matches a key here AND whose `Authorization: Bearer <token>` header
# matches the corresponding value are allowed through.
#
# Generate tokens with: python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Example: a single trusted client named "scott-desktop":
# CLIENTS_JSON={"scott-desktop": "REPLACE_WITH_LONG_RANDOM_STRING"}
#
# Multiple clients:
# CLIENTS_JSON={"scott-desktop": "token-aaa", "scott-phone": "token-bbb"}
CLIENTS_JSON={}
