# ----------------------------------------------------------------------------
# notetoself - environment configuration
# Copy this file to `.env` and fill in real values.
# ----------------------------------------------------------------------------

# --- Email transport (Gmail SMTP) -------------------------------------------
# Gmail address that will send the note (FROM). Almost always the same as the
# destination for a "note to self" tool.
SMTP_USER=beernutz@gmail.com

# Gmail "App Password" - NOT your normal Gmail password.
# Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account).
SMTP_PASS=

# Destination address (the "self" in note-to-self).
TO_EMAIL=beernutz@gmail.com

# SMTP server settings. Gmail defaults shown; only change if you know why.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- HTTP server -------------------------------------------------------------
# 0.0.0.0 listens on every interface. Change to 127.0.0.1 if you only want
# local clients to reach the server.
HOST=0.0.0.0
PORT=3001

# --- Bearer-token authorization ----------------------------------------------
# JSON array of allowed bearer tokens. Requests must carry
# `Authorization: Bearer <token>` whose value matches one of these entries.
#
# Generate tokens with: python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Single token:
# TOKENS_JSON=["REPLACE_WITH_LONG_RANDOM_STRING"]
#
# Multiple clients (each gets its own token):
# TOKENS_JSON=["token-aaa", "token-bbb"]
TOKENS_JSON=[]
